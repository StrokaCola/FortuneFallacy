{
  "rules": {
    "scores_v2": {
      ".read": true,
      ".indexOn": ["score"],
      "$entry": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['name','score','mode','constellation','date'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24 && !newData.val().matches(/[<>&\"']/) "
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000"
        },
        "mode": {
          "//": "2026-05-18 P6: regex extended to admit the lap-N partition added for Cosmic Lap endless mode. Whitelist of digits only (no negative, no decimals) so the partition stays normalized.",
          ".validate": "newData.isString() && newData.val().matches(/^(run|endless|daily-[0-9]{4}-[0-9]{2}-[0-9]{2}|lap-[0-9]{1,3})$/)"
        },
        "constellation": {
          "//": "2026-05-18 P6: tightened from free-form string to the known constellation id whitelist. Any new constellation added to the game must update this regex.",
          ".validate": "newData.isString() && newData.val().matches(/^(lyra|mensa|triumvirate|argo|fibonacci|eclipse|polyhedra|ophiuchus)$/)"
        },
        "date": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 86400000"
        },
        "version": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
